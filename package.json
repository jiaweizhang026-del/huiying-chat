{
  "name": "huiying-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build",
    "start": "node server.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/run-isolated.mjs",
    "test:hmr": "node tests/run-isolated.mjs --hmr",
    "test:live": "node tests/run-isolated.mjs --live",
    "test:production": "node tests/production.mjs",
    "test:community": "node tests/run-isolated.mjs --community",
    "test:companion": "node tests/run-isolated.mjs --companion",
    "test:visual": "node tests/run-isolated.mjs --visual",
    "format": "prettier --write src server shared server.mjs vite.config.js tests package.json index.html"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.6",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
